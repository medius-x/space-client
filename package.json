{
  "name": "space-client",
  "version": "0.1.0",
  "description": "SPACE — Electron/TypeScript desktop client for the OAK server",
  "author": "OAK project",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "out/main/main.js",
  "type": "commonjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "electron-vite dev",
    "dev2": "electron-vite dev -- --space-instance=b",
    "build": "electron-vite build",
    "start": "npm run build && electron .",
    "start2": "npm run build && electron . --space-instance=b",
    "start3": "npm run build && electron . --space-instance=c",
    "test": "vitest run",
    "watch": "vitest",
    "icons": "node scripts/regen-icons.mjs",
    "jar:sync": "node scripts/sync-server-jar.mjs",
    "images:sync": "node scripts/sync-server-images.mjs",
    "images:publish": "node scripts/publish-server-images.mjs",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir",
    "profile": "node scripts/capture-profile.mjs",
    "start:tools": "npm run build && electron . --space-devtools",
    "start2:tools": "npm run build && electron . --space-instance=b --space-devtools",
    "start3:tools": "npm run build && electron . --space-instance=c --space-devtools",
    "df3:glue": "node scripts/extract-df3-glue.mjs",
    "ns:vendor": "node scripts/vendor-ns-engines.mjs"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.2.0",
    "@workadventure/noise-suppression": "^0.1.1",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "esbuild": "^0.28.0",
    "jsdom": "^27.4.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@jitsi/rnnoise-wasm": "^0.2.1",
    "@sapphi-red/web-noise-suppressor": "^0.4.0",
    "@tanstack/react-virtual": "^3.14.11",
    "deepfilternet3-noise-filter": "^1.3.0",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "koffi": "^3.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ssh2": "^1.17.0"
  }
}
